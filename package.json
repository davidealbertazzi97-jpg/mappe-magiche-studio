{
  "name": "mappe-magiche-studio",
  "productName": "Mappe Magiche Studio",
  "version": "1.0.0",
  "description": "Applicazione desktop locale per creare mappe concettuali illustrate.",
  "main": "main.cjs",
  "author": "AI Swarm Solutions",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage",
    "build:windows": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "it.mappe.magiche.studio",
    "productName": "Mappe Magiche Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "index.html",
      "app.js",
      "style.css",
      "icon.svg",
      "fonts/**/*",
      "build/icons/**/*",
      "README.md"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icons",
      "artifactName": "Mappe-Magiche-Studio-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/app.ico",
      "artifactName": "Mappe-Magiche-Studio-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mappe Magiche Studio"
    }
  }
}
